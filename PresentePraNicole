<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jogo Flash</title>
  <script src="https://unpkg.com/@ruffle-rs/ruffle"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #000;
    }
    #player-container {
      width: 100vw;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    ruffle-player {
      width: 100% !important;
      height: 100% !important;
    }
  </style>
</head>
<body>

  <div id="player-container">
    <embed src="https://files.catbox.moe/xrvhdb.swf" width="100%" height="100%" type="application/x-shockwave-flash">
  </div>

</body>
</html>
